generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDIENTE
  EN_REVISION
  OBSERVADO
  APROBADO
  RECHAZADO
}

enum Role {
  ADMINISTRADO
  INSPECTOR
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      Role   @default(ADMINISTRADO) // ADMIN, INSPECTOR, ADMINISTRADO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itseRequests ItseRequest[]
}

model ItseRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status    RequestStatus @default(PENDIENTE)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents Document[]
}

model Document {
  id            Int         @id @default(autoincrement())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  path          String
  itseRequestId Int
  itseRequest   ItseRequest @relation(fields: [itseRequestId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}
